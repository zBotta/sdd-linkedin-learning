# Runtime secrets and config. This file is typically generated by bootstrap from SSM.
INGEST_API_TOKEN=replace-me
UI_ACCESS_PASSWORD=replace-me

# Ports exposed by docker compose
API_PORT=8000
UI_PORT=8501

# Shared DB path for API and UI containers
CLOUD_DB_PATH=/data/library.db

# Host path mounted as /data in both containers.
# Point this to an EBS-backed directory on EC2.
DATA_DIR=/srv/linkedin-library/data
