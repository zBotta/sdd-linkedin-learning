# Local sync settings
LOCAL_SYNC_STATE_PATH=.state/sync_state.json
LOCAL_SYNC_EXPORT_DIR=exports
LOCAL_SYNC_EXPORT_ENABLED=true

# LinkedIn browser settings
LINKEDIN_PROFILE_DIR=.state/playwright-profile
LINKEDIN_HEADLESS=false
LINKEDIN_SESSION_WAIT_SECONDS=120
LINKEDIN_STOP_ON_FIRST_SEEN=true
LOCAL_SYNC_FULL_RESCRAPE=false

# Push settings
PUSH_ENABLED=false
CLOUD_API_BASE_URL=https://example.com
CLOUD_INGEST_TOKEN=replace-me
PUSH_TIMEOUT_SECONDS=20

# Cloud runtime settings (Phase 6 deployment)
INGEST_API_TOKEN=replace-me
UI_ACCESS_PASSWORD=replace-me
CLOUD_DB_PATH=.state/library.db
API_PORT=8000
UI_PORT=8501
DATA_DIR=/srv/linkedin-library/data

# Stable classification settings
TAXONOMY_PATH=topics.yaml
ZEROSHOT_MIN_SIMILARITY=
SECONDARY_MIN_SIMILARITY=
CLASSIFICATION_RUNS_PATH=.state/classification_runs.jsonl

# Discovery settings
DISCOVERY_LOW_CONFIDENCE_THRESHOLD=0.45
DISCOVERY_RECENT_WINDOW_DAYS=7
DISCOVERY_RUNS_PATH=.state/discovery_runs.jsonl
DISCOVERY_CANDIDATES_PATH=.state/topic_candidates.jsonl
# Path to local GGUF model used for optional label refinement.
# Windows example: C:/Users/my_user/.models/Llama-3.2-1B-Instruct-Q4_K_S.gguf
LLAMA_CPP_MODEL_PATH=
# Optional local sentence-transformer path for restricted networks where online
# Hugging Face download is blocked by enterprise TLS/proxy constraints.
LOCAL_EMBEDDING_MODEL_PATH=
